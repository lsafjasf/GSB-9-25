    "ru": {
      "fallback": ["en"],
      "number": {"thousands_sep": " ", "decimal_sep": ",", "decimal_places": null},
      "date": {"order": "DMY", "separator": ".", "pad": true},
      "plural": {
        "categories": [
          {"name": "one", "when": "n % 10 = 1 and n % 100 != 11"},
