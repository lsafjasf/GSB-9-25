{
  "language": "zh",
  "plural_rule": "other_only",
  "joiner": "",
  "component_template": "{value}{unit}",
  "past": "{span}前",
  "future": "{span}后",
  "below_min_unit": { "mode": "just_now", "text": "刚刚" },
  "units": [
    { "id": "year",   "seconds": 31557600, "forms": { "other": "年" } },
