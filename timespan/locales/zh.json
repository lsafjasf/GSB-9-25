    { "id": "week",   "seconds": 604800,   "forms": { "other": "周" } },
    { "id": "day",    "seconds": 86400,    "forms": { "other": "天" } },
    { "id": "hour",   "seconds": 3600,     "forms": { "other": "小时" } },
    { "id": "minute", "seconds": 60,       "forms": { "other": "分钟" } },
    { "id": "second", "seconds": 1,        "forms": { "other": "秒" } }
  ]
